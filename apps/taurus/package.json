{
	"name": "taurus",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "infisical run --env=dev --path=/taurus -- vike dev --port 3005 --host",
		"build:staging": "cross-env STAGE=staging infisical run --env=prod --path=/taurus -- vike build",
		"build:prod": "cross-env STAGE=prod infisical run --env=prod --path=/taurus -- vike build",
		"start:prod": "infisical run --env=prod --path=/taurus -- node ./dist/server/index.mjs --port 3005",
		"preview": "vike preview --port 3005 --host",
		"--------------": "",
		"lint": "pnpm biome lint",
		"type-check": "tsc --build",
		"------------------": "",
		"deploy": "wrangler deploy",
		"deploy:all": "pnpm type-check && pnpm build:prod && pnpm deploy",
		"-------------------": "",
		"prepare": "pnpm dlx tailwindcss-patch install"
	},
	"sideEffects": [
		"**/*.css"
	],
	"dependencies": {
		"@ark-ui/solid": "5.36.2",
		"@bprogress/core": "1.3.4",
		"@corvu/drawer": "0.2.4",
		"@reatom/framework": "3.4.68",
		"@reatom/npm-solid-js": "3.6.2",
		"@reatom/persist": "3.4.3",
		"@tiptap/core": "3.10.5",
		"@tiptap/extension-image": "3.10.5",
		"@tiptap/extension-table": "3.10.5",
		"@tiptap/extension-text-style": "3.10.5",
		"@tiptap/extensions": "3.10.5",
		"@tiptap/html": "3.10.5",
		"@tiptap/starter-kit": "3.10.5",
		"@tiptap/static-renderer": "3.10.5",
		"@vikejs/hono": "0.2.1",
		"cnfast": "0.0.6",
		"dayjs": "1.11.11",
		"hono": "4.12.26",
		"openapi-fetch": "0.17.0",
		"solid-js": "1.9.13",
		"solid-sonner": "0.3.1",
		"tailwind-variants": "3.1.1",
		"vike": "0.4.259",
		"vike-solid": "0.8.2",
		"zod": "4.1.11"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.42.1",
		"@inlang/cli": "3.0.0",
		"@inlang/paraglide-js": "2.18.0",
		"@neodx/svg": "0.8.0",
		"@repo/config-biome": "workspace:*",
		"@repo/config-typescript": "workspace:*",
		"@repo/shared": "workspace:*",
		"@tailwindcss/vite": "4.3.0",
		"tailwind-scrollbar": "4.0.2",
		"tailwindcss": "4.1.8",
		"tailwindcss-patch": "^9.5.0",
		"tw-animate-css": "1.3.4",
		"typescript": "5.8.3",
		"unplugin-tailwindcss-mangle": "5.1.4",
		"vite": "8.0.14",
		"vite-bundle-analyzer": "1.3.8",
		"wrangler": "4.103.0"
	}
}
